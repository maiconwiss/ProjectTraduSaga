<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TraduSaga.Controls">

    <Style TargetType="{x:Type controls:HotkeyInput}">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Style.Resources>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>