<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <system:Double x:Key="ControlHeight">32</system:Double>
    <system:Double x:Key="ControlHeightSmall">24</system:Double>

    <CornerRadius x:Key="CompactControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>

    <Thickness x:Key="ControlPadding">12,0,12,0</Thickness>
    <Thickness x:Key="SurfacePadding">16</Thickness>
    <Thickness x:Key="SettingsPagePadding">24</Thickness>

</ResourceDictionary>
