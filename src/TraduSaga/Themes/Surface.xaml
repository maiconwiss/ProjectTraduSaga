<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsSection" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SurfaceCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource SurfacePadding}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style
        x:Key="SettingsPageHeader"
        BasedOn="{StaticResource TextBlockBase}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

</ResourceDictionary>
