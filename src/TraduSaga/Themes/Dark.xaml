<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignExtensions;component/Themes/MaterialDesignDarkTheme.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/materialdesigncolor.cyan.accent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="AppBackgroundColor">#111318</Color>
    <Color x:Key="SurfaceColor">#1B2028</Color>
    <Color x:Key="ElevatedSurfaceColor">#29313D</Color>
    <Color x:Key="AccentColor">#5DCAB5</Color>
    <Color x:Key="AccentTextColor">#111318</Color>
    <Color x:Key="PrimaryTextColor">#F3F5F7</Color>
    <Color x:Key="SecondaryTextColor">#AAB2C0</Color>
    <Color x:Key="BorderColor">#343B46</Color>
    <Color x:Key="SurfaceHoverColor">#343B46</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="PrimaryHueLightForegroundBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#45A894" />
    <SolidColorBrush x:Key="PrimaryHueDarkForegroundBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="SecondaryHueLightBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SecondaryHueLightForegroundBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{StaticResource ElevatedSurfaceColor}" />
    <SolidColorBrush x:Key="SecondaryHueMidForegroundBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryHueDarkBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryHueDarkForegroundBrush" Color="{StaticResource AppBackgroundColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#f03a16" />
    <SolidColorBrush x:Key="WarningBrush" Color="#ffdad6" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ChromeForegroundBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ChromeSelectionBrush" Color="{StaticResource ElevatedSurfaceColor}" />

</ResourceDictionary>
