<UserControl
    x:Class="TraduSaga.MVVM.Views.LanguagesSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:controls="clr-namespace:TraduSaga.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:translation="clr-namespace:TraduSaga.Translation;assembly=TraduSaga.Translation"
    xmlns:tts="clr-namespace:TraduSaga.TTS;assembly=TraduSaga.TTS"
    Unloaded="LanguagesSettingsView_Unloaded"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ObjectDataProvider
            x:Key="dataFromEnum"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="translation:Translators" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider
            x:Key="ttsSystems"
            MethodName="GetValues"
            ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="tts:TTSEngines" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Style="{StaticResource SettingsPageHeader}"
                Text="{DynamicResource Str.Navigation.Languages}" />
            <Border Style="{StaticResource SettingsSection}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
            <StackPanel.Resources>
                <Style TargetType="{x:Type StackPanel}">
                    <Setter Property="Margin" Value="0,0,0,20" />
                </Style>
            </StackPanel.Resources>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableLanguages}"
                    SelectedValue="{Binding Path=TranslateFromLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="12,0,0,0"
                    Content="{DynamicResource Str.LangSettings.SourceLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    FontSize="14"
                    ItemsSource="{Binding Path=AvailableTranslationLanguages}"
                    MaxDropDownHeight="300"
                    SelectedValue="{Binding Path=TranslateToLang}"
                    SelectedValuePath="LanguageDescriptor.Language"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="12,0,0,0"
                    Content="{DynamicResource Str.LangSettings.TranslationLang}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Width="130"
                    FontSize="14"
                    ItemsSource="{Binding Source={StaticResource dataFromEnum}}"
                    SelectedItem="{Binding Path=Translator}"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.Translator}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsDeeplSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <PasswordBox
                        x:Name="DeeplApiKeyInput"
                        Width="220"
                        VerticalContentAlignment="Center"
                        FontSize="14" />
                    <Button
                        Margin="6,0,0,0"
                        Content="{DynamicResource Str.LangSettings.SaveApiKey}"
                        Click="SaveDeeplApiKey_Click" />
                    <Label
                        Margin="12,0,0,0"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource Str.LangSettings.DeeplApiKey}"
                        Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding DeeplApiKeyStatus}" VerticalAlignment="Center" />
                    <Button
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsDeeplApiKeyConfigured}"
                        Content="{Binding DeeplApiKeyRevealAction}"
                        Click="ToggleDeeplApiKeyReveal_Click" />
                    <Button
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsDeeplApiKeyConfigured}"
                        Content="{DynamicResource Str.LangSettings.DeleteApiKey}"
                        Click="DeleteDeeplApiKey_Click" />
                </StackPanel>
                <TextBox
                    Margin="0,4,0,0"
                    IsReadOnly="True"
                    Text="{Binding DeeplApiKey}"
                    Visibility="{Binding IsDeeplApiKeyRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsYandexSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <PasswordBox
                        x:Name="YandexApiKeyInput"
                        Width="220"
                        VerticalContentAlignment="Center"
                        FontSize="14" />
                    <Button
                        Margin="6,0,0,0"
                        Content="{DynamicResource Str.LangSettings.SaveApiKey}"
                        Click="SaveYandexApiKey_Click" />
                    <Label
                        Margin="12,0,0,0"
                        HorizontalAlignment="Stretch"
                        Content="{DynamicResource Str.LangSettings.YandexApiKey}"
                        Style="{StaticResource ControlCaptionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Text="{Binding YandexApiKeyStatus}" VerticalAlignment="Center" />
                    <Button
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsYandexApiKeyConfigured}"
                        Content="{Binding YandexApiKeyRevealAction}"
                        Click="ToggleYandexApiKeyReveal_Click" />
                    <Button
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsYandexApiKeyConfigured}"
                        Content="{DynamicResource Str.LangSettings.DeleteApiKey}"
                        Click="DeleteYandexApiKey_Click" />
                </StackPanel>
                <TextBox
                    Margin="0,4,0,0"
                    IsReadOnly="True"
                    Text="{Binding YandexApiKey}"
                    Visibility="{Binding IsYandexApiKeyRevealed, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,20">
                <Label
                    Content="{DynamicResource Str.LangSettings.PrivacyHeading}"
                    Style="{StaticResource ControlCaptionLabel}" />
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource TextBlockBase}"
                    Text="{DynamicResource Str.LangSettings.PrivacyDescription}"
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        Content="{DynamicResource Str.LangSettings.AllowGoogleConsent}"
                        IsChecked="{Binding IsGoogleConsentGranted}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Text="{Binding GoogleConsentStatus}"
                        VerticalAlignment="Center" />
                    <Button
                        Margin="8,0,0,0"
                        Click="ForgetGoogleConsent_Click"
                        Content="{DynamicResource Str.LangSettings.ForgetConsent}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        Content="{DynamicResource Str.LangSettings.AllowDeeplConsent}"
                        IsChecked="{Binding IsDeeplConsentGranted}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Text="{Binding DeeplConsentStatus}"
                        VerticalAlignment="Center" />
                    <Button
                        Margin="8,0,0,0"
                        Click="ForgetDeeplConsent_Click"
                        Content="{DynamicResource Str.LangSettings.ForgetConsent}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox
                        Content="{DynamicResource Str.LangSettings.AllowYandexConsent}"
                        IsChecked="{Binding IsYandexConsentGranted}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Text="{Binding YandexConsentStatus}"
                        VerticalAlignment="Center" />
                    <Button
                        Margin="8,0,0,0"
                        Click="ForgetYandexConsent_Click"
                        Content="{DynamicResource Str.LangSettings.ForgetConsent}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Width="130"
                    FontSize="14"
                    ItemsSource="{Binding Source={StaticResource ttsSystems}}"
                    SelectedItem="{Binding Path=TtsSystem}"
                    Style="{StaticResource ComboBoxBase}" />
                <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.TtsSystem}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTtsWindowsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox 
                    ItemsSource="{Binding AvailableVoices}"
                    SelectedItem="{Binding SelectedVoice, Mode=TwoWay}"
                    DisplayMemberPath="Name"
                    Width="130"
                    FontSize="14"
                    Style="{StaticResource ComboBoxBase}"/>
                <Label
                    Margin="12,0,0,0"
                    HorizontalAlignment="Stretch"
                    Content="{DynamicResource Str.LangSettings.Voices}"
                    Style="{StaticResource ControlCaptionLabel}" />
            </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>