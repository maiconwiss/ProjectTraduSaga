<Window
    x:Class="TraduSaga.MVVM.Views.ProviderConsentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock
            x:Name="HeadingText"
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="ExplanationText"
            TextWrapping="Wrap" />
        <TextBlock Margin="0,12,0,18">
            <Hyperlink
                x:Name="PrivacyPolicyLink"
                RequestNavigate="PrivacyPolicyLink_RequestNavigate" />
        </TextBlock>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Click="DenyButton_Click"
                Content="{DynamicResource Str.Consent.Deny}" />
            <Button
                Margin="0,0,8,0"
                Click="CancelButton_Click"
                Content="{DynamicResource Str.Consent.Cancel}"
                IsCancel="True" />
            <Button
                Click="AllowButton_Click"
                Content="{DynamicResource Str.Consent.Allow}" />
        </StackPanel>
    </StackPanel>
</Window>
