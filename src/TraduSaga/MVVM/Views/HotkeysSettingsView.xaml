<UserControl
    x:Class="TraduSaga.MVVM.Views.HotkeysSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:common="clr-namespace:TraduSaga.MVVM.Common"
    xmlns:controls="clr-namespace:TraduSaga.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <common:KeyCombinationValueConverter x:Key="KeyCombinationConverter" />
        <common:GamepadKeyCombinationValueConverter x:Key="GamepadKeyCombinationValueConverter" />
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock
                Style="{StaticResource SettingsPageHeader}"
                Text="{DynamicResource Str.Navigation.HotKeys}" />
            <Border Style="{StaticResource SettingsSection}">
                <DockPanel LastChildFill="True">
                    <ItemsControl
                        Name="IcHotKeys"
                        DockPanel.Dock="Top"
                        ItemsSource="{Binding Model}">
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="FrameworkElement.Margin" Value="0,0,0,8" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12,4"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:HotkeyInput
                                            Width="90"
                                            VerticalContentAlignment="Center"
                                            Background="{DynamicResource ElevatedSurfaceBrush}"
                                            GamepadHotKey="{Binding GamepadHotKey, Mode=TwoWay, Converter={StaticResource GamepadKeyCombinationValueConverter}}"
                                            HotKey="{Binding HotKey, Mode=TwoWay, Converter={StaticResource KeyCombinationConverter}}">
                                            <b:Interaction.Triggers>
                                                <b:EventTrigger EventName="LostFocus">
                                                    <b:InvokeCommandAction Command="{Binding DataContext.ExitEditModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </b:EventTrigger>
                                                <b:EventTrigger EventName="GotFocus">
                                                    <b:InvokeCommandAction Command="{Binding DataContext.EnterEditModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </b:EventTrigger>
                                            </b:Interaction.Triggers>
                                        </controls:HotkeyInput>
                                        <Label Content="{Binding Description}" Style="{StaticResource ControlCaptionLabel}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,8,0,0" DockPanel.Dock="Bottom">
                        <TextBlock
                            Margin="8,0,8,8"
                            Text="{DynamicResource Str.Hotkeys.SpeakerAreaInstructions}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="8,0,12,0"
                                VerticalAlignment="Center"
                                Text="{Binding SpeakerAreaStatus}" />
                            <Button
                                IsEnabled="{Binding IsSpeakerAreaConfigured}"
                                Content="{DynamicResource Str.Hotkeys.ClearSpeakerArea}"
                                Command="{Binding ClearSpeakerAreaCommand}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
