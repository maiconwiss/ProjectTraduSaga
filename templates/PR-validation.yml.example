# TEMPLATE INERTE — não está no diretório .github/workflows.
# Exemplo inerte, não é uma cópia literal do workflow existente.
# O workflow ativo também roda em workflow_dispatch e em PRs para qualquer branch;
# este exemplo restringe PRs à main e desativa a persistência das credenciais do checkout.
# Não publica releases, não usa secrets e não assina artefatos.
name: TraduSaga PR validation (template)

on:
  pull_request:
    branches: ["main"]

permissions:
  contents: read

jobs:
  validate:
    runs-on: windows-latest
    steps:
      - name: Checkout
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false

      - name: Setup .NET
        uses: actions/setup-dotnet@67a3573c9a986a3f9c594539f4ab511d57bb3ce9
        with:
          dotnet-version: 8.0.x

      - name: Restore locked dependencies
        run: dotnet restore TraduSaga.sln --locked-mode

      - name: Run security tests
        run: dotnet test tests/TraduSaga.Security.Tests/TraduSaga.Security.Tests.csproj --configuration Release --no-restore -p:SkipPredictionModelCopy=true

      - name: Build
        run: dotnet build TraduSaga.sln --configuration Release --no-restore -p:SkipPredictionModelCopy=true

# A criação de release não está incluída porque os modelos de previsão ainda
# não têm origem/licença/hash rastreáveis no repositório. Não ativar um workflow
# de publicação até resolver esse requisito e revisar as actions usadas.
